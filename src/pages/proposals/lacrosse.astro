---
export const prerender = false;

const PASSWORD = import.meta.env.LACROSSE_PROPOSAL_PASSWORD;
const COOKIE_NAME = "shinkan_lacrosse_auth";

let loginError = false;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const input = form.get("password");
  if (input === PASSWORD) {
    Astro.cookies.set(COOKIE_NAME, PASSWORD, {
      path: "/",
      httpOnly: true,
      maxAge: 60 * 60 * 24 * 30,
      sameSite: "lax",
    });
    return Astro.redirect("/proposals/lacrosse", 302);
  } else {
    loginError = true;
  }
}

const authed = Astro.cookies.get(COOKIE_NAME)?.value === PASSWORD;

const pageTitle = '新歓映画館2027 ご案内';
const fontsHref = 'https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500;700;900&family=Roboto+Mono:wght@400;500;700&display=swap';
const pageCss = '\n:root {\n  --ink: #0d0b12;\n  --surface: #16121f;\n  --surface-2: #1e1830;\n  --line: #322a48;\n  --gold: #ffb400;\n  --gold-deep: #cc8f00;\n  --gold-soft: rgba(255,180,0,0.12);\n  --purple: #7657e0;\n  --purple-deep: #4a28b4;\n  --purple-soft: rgba(118,87,224,0.16);\n  --paper: #f4efe4;\n  --ink-soft: #cbc3dc;\n  --ink-faint: #8d84a6;\n}\n\n* { box-sizing: border-box; }\n\nbody {\n  margin: 0;\n  background: var(--ink);\n  color: var(--paper);\n  font-family: "Zen Kaku Gothic New", "Hiragino Sans", sans-serif;\n  font-feature-settings: "palt";\n  -webkit-font-smoothing: antialiased;\n}\n\n.mono { font-family: "Roboto Mono", ui-monospace, monospace; font-variant-numeric: tabular-nums; }\na { color: inherit; }\n\n.wrap { max-width: 980px; margin: 0 auto; padding: 0 24px 100px; }\n\n/* ---------- HERO ---------- */\n.hero {\n  position: relative;\n  padding: 90px 24px 80px;\n  text-align: center;\n  overflow: hidden;\n  background:\n    radial-gradient(ellipse 900px 500px at 50% -10%, rgba(255,180,0,0.16), transparent 60%),\n    radial-gradient(ellipse 700px 400px at 85% 10%, rgba(118,87,224,0.14), transparent 60%),\n    var(--ink);\n  border-bottom: 1px solid var(--line);\n}\n.hero::before, .hero::after {\n  content: "";\n  position: absolute;\n  top: 0; bottom: 0;\n  width: 46px;\n  background-image: repeating-linear-gradient(180deg, transparent 0 14px, rgba(255,180,0,0.35) 14px 18px);\n  opacity: 0.5;\n}\n.hero::before { left: 6%; }\n.hero::after { right: 6%; }\n.hero-eyebrow {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  font-family: "Roboto Mono", monospace;\n  font-size: 0.74rem;\n  letter-spacing: 0.22em;\n  color: var(--gold);\n  border: 1px solid var(--gold-deep);\n  border-radius: 999px;\n  padding: 6px 16px;\n  margin-bottom: 26px;\n}\n.hero h1 {\n  font-size: clamp(2.2rem, 5.2vw, 3.4rem);\n  font-weight: 900;\n  line-height: 1.25;\n  margin: 0 0 18px;\n  text-wrap: balance;\n}\n.hero h1 .accent { color: var(--gold); }\n.hero .lede {\n  font-size: clamp(1rem, 2vw, 1.2rem);\n  color: var(--ink-soft);\n  max-width: 560px;\n  margin: 0 auto 30px;\n  line-height: 1.9;\n}\n.hero .to {\n  font-family: "Roboto Mono", monospace;\n  font-size: 0.8rem;\n  letter-spacing: 0.08em;\n  color: var(--ink-faint);\n}\n.hero .to strong { color: var(--paper); font-weight: 700; }\n\n/* ---------- SECTION shell ---------- */\nsection { padding: 64px 0; border-bottom: 1px solid var(--line); }\nsection:last-of-type { border-bottom: none; }\n.section-head { margin-bottom: 34px; text-align: center; }\n.section-head .num {\n  font-family: "Roboto Mono", monospace;\n  font-size: 0.76rem;\n  letter-spacing: 0.2em;\n  color: var(--gold);\n  display: block;\n  margin-bottom: 10px;\n}\n.section-head h2 { font-size: clamp(1.4rem, 3vw, 1.9rem); font-weight: 900; margin: 0 0 10px; }\n.section-head p { color: var(--ink-soft); font-size: 0.94rem; max-width: 560px; margin: 0 auto; line-height: 1.8; }\n\n/* ---------- VALUE REELS (4 points) ---------- */\n.reels { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }\n@media (max-width: 700px) { .reels { grid-template-columns: 1fr; } }\n.reel {\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: 16px;\n  padding: 28px 26px;\n  position: relative;\n  overflow: hidden;\n}\n.reel::before {\n  content: attr(data-n);\n  position: absolute;\n  top: -14px; right: -6px;\n  font-family: "Roboto Mono", monospace;\n  font-size: 4.6rem;\n  font-weight: 700;\n  color: rgba(255,180,0,0.07);\n  line-height: 1;\n}\n.reel-icon { font-size: 1.6rem; margin-bottom: 14px; }\n.reel h3 { font-size: 1.02rem; font-weight: 700; margin: 0 0 10px; color: var(--paper); }\n.reel p { font-size: 0.88rem; color: var(--ink-soft); line-height: 1.85; margin: 0; }\n\n/* ---------- OVERVIEW ---------- */\n.overview-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 24px; align-items: stretch; }\n@media (max-width: 760px) { .overview-grid { grid-template-columns: 1fr; } }\n.venue-photo { border-radius: 18px; overflow: hidden; border: 1px solid var(--line); min-height: 220px; }\n.venue-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }\n\n/* ---------- EVENT INFO CARD ---------- */\n.info-card {\n  background: linear-gradient(155deg, var(--surface-2), var(--surface));\n  border: 1px solid var(--line);\n  border-radius: 18px;\n  padding: 34px 36px;\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 22px 40px;\n}\n@media (max-width: 640px) { .info-card { grid-template-columns: 1fr; } }\n.info-row { display: flex; flex-direction: column; gap: 4px; padding-bottom: 16px; border-bottom: 1px dashed var(--line); }\n.info-row .label { font-family: "Roboto Mono", monospace; font-size: 0.68rem; letter-spacing: 0.14em; color: var(--gold); }\n.info-row .value { font-size: 1rem; font-weight: 700; color: var(--paper); }\n.info-row .note { font-size: 0.78rem; color: var(--ink-faint); }\n\n/* ---------- IMAGE MOCKUP ---------- */\n.mockup-section { padding-top: 0; }\n.mockup-frame { border-radius: 18px; overflow: hidden; border: 1px solid var(--line); box-shadow: 0 20px 60px rgba(0,0,0,0.35); }\n.mockup-frame img { display: block; width: 100%; height: auto; }\n.mockup-caption { text-align: center; font-size: 0.82rem; color: var(--ink-faint); margin-top: 14px; }\n\n/* ---------- OVERVIEW: featured mechanics ---------- */\n.feature-sub { margin-top: 40px; }\n.feature-sub-head { text-align: center; margin-bottom: 22px; }\n.feature-sub-head h3 { font-size: 1.1rem; font-weight: 900; margin: 0 0 6px; }\n.feature-sub-head p { font-size: 0.84rem; color: var(--ink-soft); margin: 0; }\n.feature-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }\n@media (max-width: 700px) { .feature-grid { grid-template-columns: 1fr; } }\n.feature-card {\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: 16px;\n  padding: 24px;\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n.feature-card h4 { margin: 0; font-size: 0.98rem; font-weight: 700; }\n.feature-card .desc { margin: 0; font-size: 0.82rem; color: var(--ink-soft); line-height: 1.8; }\n\n/* vote mock */\n.vote-mock { background: var(--surface-2); border: 1px solid var(--line); border-radius: 12px; padding: 16px; }\n.vote-mock .vm-head { display: flex; align-items: center; gap: 8px; font-family: "Roboto Mono", monospace; font-size: 0.66rem; letter-spacing: 0.08em; color: var(--gold); margin-bottom: 12px; }\n.vote-mock .vm-head::before { content: "LINE"; background: #06c755; color: #fff; border-radius: 4px; padding: 1px 6px; font-size: 0.6rem; }\n.vote-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }\n.vote-col-title { font-size: 0.68rem; color: var(--ink-faint); margin-bottom: 8px; text-align: center; }\n.vote-rank { display: flex; align-items: center; gap: 8px; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 6px 10px; margin-bottom: 6px; font-size: 0.72rem; }\n.vote-rank .rn { font-family: "Roboto Mono", monospace; color: var(--gold); font-weight: 700; width: 14px; }\n.vote-rank .rb { width: 18px; height: 18px; border-radius: 5px; background: var(--purple-soft); flex-shrink: 0; }\n\n/* ticket mock */\n.ticket-mock {\n  position: relative;\n  background: linear-gradient(135deg, var(--gold), var(--gold-deep));\n  color: var(--ink);\n  border-radius: 10px;\n  padding: 16px 20px;\n  display: flex;\n  align-items: center;\n  gap: 14px;\n}\n.ticket-mock::before, .ticket-mock::after {\n  content: "";\n  position: absolute;\n  top: 50%; transform: translateY(-50%);\n  width: 16px; height: 16px;\n  border-radius: 50%;\n  background: var(--surface);\n}\n.ticket-mock::before { left: -8px; }\n.ticket-mock::after { right: -8px; }\n.ticket-mock { min-height: 108px; }\n.ticket-mock .tm-icon { flex-shrink: 0; width: 38px; height: 38px; border-radius: 50%; background: rgba(13,11,18,0.12); display: flex; align-items: center; justify-content: center; padding: 8px; }\n.ticket-mock .tm-icon svg { width: 100%; height: 100%; }\n.ticket-mock .tm-text { flex: 1; }\n.ticket-mock .tm-title { font-weight: 900; font-size: 0.94rem; }\n.ticket-mock .tm-sub { font-family: "Roboto Mono", monospace; font-size: 0.66rem; letter-spacing: 0.04em; opacity: 0.75; margin-top: 2px; }\n.ticket-mock .tm-num { font-family: "Roboto Mono", monospace; font-size: 0.7rem; border: 1px dashed var(--ink); border-radius: 6px; padding: 3px 8px; }\n.ticket-side-label { font-family: "Roboto Mono", monospace; font-size: 0.62rem; letter-spacing: 0.12em; color: var(--ink-faint); margin-bottom: 6px; }\n.ticket-back {\n  min-height: 108px;\n  position: relative;\n  background: var(--surface-2);\n  border: 1.5px dashed var(--gold-deep);\n  border-radius: 10px;\n  padding: 16px 20px;\n  display: flex;\n  align-items: center;\n  gap: 16px;\n}\n.ticket-back::before, .ticket-back::after {\n  content: "";\n  position: absolute;\n  top: 50%; transform: translateY(-50%);\n  width: 16px; height: 16px;\n  border-radius: 50%;\n  background: var(--surface);\n}\n.ticket-back::before { left: -8px; }\n.ticket-back::after { right: -8px; }\n.ticket-back .qr-mock { flex-shrink: 0; width: 56px; height: 56px; }\n.ticket-back .tb-rows { flex: 1; display: flex; flex-direction: column; gap: 6px; }\n.ticket-back .tb-row { display: flex; gap: 8px; font-size: 0.74rem; }\n.ticket-back .tb-row .tb-label { font-family: "Roboto Mono", monospace; font-size: 0.62rem; letter-spacing: 0.06em; color: var(--gold); width: 62px; flex-shrink: 0; padding-top: 1px; }\n.ticket-back .tb-row .tb-value { color: var(--paper); }\n\n\n/* ---------- TIMELINE (day flow / schedule) ---------- */\n.dayflow { display: flex; flex-direction: column; gap: 0; }\n.dayflow-item { display: grid; grid-template-columns: 68px 20px 1fr; column-gap: 14px; padding: 14px 0; position: relative; }\n.dayflow-item.conditional { opacity: 0.72; }\n.dayflow-time { font-family: "Roboto Mono", monospace; font-size: 0.78rem; color: var(--gold); text-align: right; padding-top: 4px; }\n.dayflow-marker { position: relative; display: flex; justify-content: center; }\n.dayflow-marker .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 4px var(--gold-soft); margin-top: 7px; flex-shrink: 0; }\n.dayflow-item.key .dayflow-marker .dot { width: 12px; height: 12px; background: var(--gold); box-shadow: 0 0 0 5px var(--gold-soft); margin-top: 5px; }\n.dayflow-item:not(:last-child) .dayflow-marker::after {\n  content: "";\n  position: absolute;\n  left: 50%; top: 22px; bottom: -14px;\n  width: 1px;\n  background: var(--line);\n  transform: translateX(-50%);\n}\n.dayflow-body h4 { margin: 0 0 4px; font-size: 0.92rem; font-weight: 700; display: flex; align-items: center; gap: 8px; }\n.dayflow-body p { margin: 0; font-size: 0.8rem; color: var(--ink-soft); line-height: 1.7; }\n.key-badge { font-family: "Roboto Mono", monospace; font-size: 0.62rem; letter-spacing: 0.06em; color: var(--ink); background: var(--gold); border-radius: 999px; padding: 2px 8px; }\n.cond-badge { font-family: "Roboto Mono", monospace; font-size: 0.62rem; letter-spacing: 0.04em; color: var(--ink-faint); border: 1px solid var(--line); border-radius: 999px; padding: 2px 8px; }\n\n/* ---------- STATS ---------- */\n.track-grid { display: grid; grid-template-columns: 1fr 0.85fr; gap: 24px; align-items: center; }\n@media (max-width: 700px) { .track-grid { grid-template-columns: 1fr; } }\n.track-media { display: flex; flex-direction: column; gap: 14px; }\n.track-visual { border-radius: 14px; overflow: hidden; border: 1px solid var(--line); }\n.track-visual img { display: block; width: 100%; height: auto; }\n.stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }\n@media (max-width: 480px) { .stats { grid-template-columns: 1fr; } }\n.stat { text-align: center; padding: 20px 10px; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; }\n.stat .n { font-family: "Roboto Mono", monospace; font-size: 1.5rem; font-weight: 700; color: var(--gold); }\n.stat .l { font-size: 0.72rem; color: var(--ink-faint); margin-top: 6px; }\n\n/* ---------- ASK ---------- */\n.ask-card {\n  background: var(--surface);\n  border: 1px solid var(--gold-deep);\n  border-radius: 16px;\n  padding: 30px 32px;\n}\n.ask-card h3 { margin: 0 0 14px; font-size: 1.05rem; }\n.ask-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }\n.ask-list li { display: flex; gap: 12px; font-size: 0.9rem; color: var(--ink-soft); line-height: 1.8; }\n.ask-list li .chk { color: var(--gold); flex-shrink: 0; }\n.price-note { margin-top: 20px; padding-top: 18px; border-top: 1px dashed var(--line); font-size: 0.82rem; color: var(--ink-faint); line-height: 1.9; }\n\n/* ---------- CONTACT ---------- */\n.contact-block { text-align: center; }\n.ticket {\n  display: inline-block;\n  background: var(--gold);\n  color: var(--ink);\n  border-radius: 10px;\n  padding: 18px 40px;\n  font-weight: 900;\n  font-size: 1.05rem;\n  position: relative;\n}\n.ticket::before, .ticket::after {\n  content: "";\n  position: absolute;\n  top: 50%; transform: translateY(-50%);\n  width: 18px; height: 18px;\n  border-radius: 50%;\n  background: var(--ink);\n}\n.ticket::before { left: -9px; }\n.ticket::after { right: -9px; }\n.contact-sub { margin-top: 18px; font-size: 0.82rem; color: var(--ink-faint); }\n\nfooter { text-align: center; padding: 40px 24px; color: var(--ink-faint); font-size: 0.76rem; }\n\n@media print {\n  @page { size: A4; margin: 0; }\n  * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; color-adjust: exact !important; }\n  body { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\n  .hero { padding: 56px 24px 48px; }\n  section { padding: 40px 0; }\n  .reel, .stat, .track-visual, .venue-photo, .dayflow-item, .info-row, .ask-card, .feature-card, .mockup-frame { break-inside: avoid; }\n  .section-head { break-after: avoid; }\n  .section-head, h2, h3, h4 { break-after: avoid; }\n}\n';
const pageBody = '<div class="hero">\n  <span class="hero-eyebrow">SHINKAN CINEMA 2027 ・ FOR ラクロス部様</span>\n  <h1>あなたの部活動が、<br class="mobile-br"><span class="accent">スクリーンに輝く。</span></h1>\n  <p class="lede">\n    北海道大学の新入生に向けて、映画館を貸し切って各団体のPVを上映する新歓企画「新歓映画館」。\n    ラクロス部様の魅力を、大画面と大音響で新入生の記憶に焼き付けませんか。\n  </p>\n  <div class="to">ご案内先: <strong>北海道大学 ラクロス部様</strong> ／ 企画運営: 大学スタイル</div>\n</div>\n\n<div class="wrap">\n\n  <section class="mockup-section">\n    <div class="mockup-frame">\n      <img src="data:image/png;base64," alt="映画館スクリーンにラクロス部PVを投影したイメージ" />\n    </div>\n    <p class="mockup-caption">実際の会場イメージ（合成）。大画面・大音響で、この熱量をそのまま新入生に届けます。</p>\n  </section>\n\n  <section id="why">\n    <div class="section-head">\n      <span class="num">01 — WHY CINEMA</span>\n      <h2>なぜ、映画館でやるのか</h2>\n      <p>チラシやオンライン新歓だけでは伝わらない熱量を、映画館という非日常の場で届けます。</p>\n    </div>\n    <div class="reels">\n      <div class="reel" data-n="01">\n        <div class="reel-icon">🎬</div>\n        <h3>大画面・大音響でPVに魅入ってもらえる</h3>\n        <p>スマホの小さな画面では伝わらない迫力・熱量を、映画館のスクリーンとサウンドシステムでそのまま届けられます。新入生がラクロス部様のPVに没入する90分。</p>\n      </div>\n      <div class="reel" data-n="02">\n        <div class="reel-icon">🎟️</div>\n        <h3>類を見ない事例としてのキャッチーさ</h3>\n        <p>「新歓を映画館でやる」こと自体が話題性を持ち、SNSでの拡散や口コミにもつながります。数ある新歓の中で埋もれない、圧倒的な印象を残せます。</p>\n      </div>\n      <div class="reel" data-n="03">\n        <div class="reel-icon">📊</div>\n        <h3>上映後の団体投票機能で関心度を可視化</h3>\n        <p>上映後、公式LINEで新入生に2種類のランキング投票を実施。「印象的だった団体」と「気になる団体」を、それぞれ1位〜3位まで複数選択で回答してもらいます。「見た人」ではなく「印象に残った・興味を持った」人のデータが、団体側にそのまま共有されます。</p>\n      </div>\n      <div class="reel" data-n="04">\n        <div class="reel-icon">🍚</div>\n        <h3>新歓飯チケットで、ランダムな出会いを創出</h3>\n        <p>入場時に新入生全員へ新歓飯チケットを配布。上映後はそのままランダムな組み合わせでのご飯会に合流できる導線を用意しています。「見て終わり」ではなく、当日のうちに次の接触・新しい出会いにつなげます。</p>\n      </div>\n    </div>\n  </section>\n\n  <section id="overview">\n    <div class="section-head">\n      <span class="num">02 — OVERVIEW</span>\n      <h2>企画概要</h2>\n      <p>2027年4月の新歓シーズンに向けて開催準備中。詳細日程は参加団体確定後に確定します。</p>\n    </div>\n    <div class="overview-grid">\n      <div class="venue-photo">\n        <img src="data:image/jpeg;base64," alt="札幌シネマフロンティア 場内">\n      </div>\n      <div class="info-card">\n        <div class="info-row">\n          <span class="label">DATE</span>\n          <span class="value">2027年3月下旬〜4月上旬（予定）</span>\n          <span class="note">新入生の入学直後、新歓シーズンの中でも特に注目度が高い時期</span>\n        </div>\n        <div class="info-row">\n          <span class="label">VENUE</span>\n          <span class="value">札幌シネマフロンティア 他</span>\n          <span class="note">札幌市内の映画館を貸し切り</span>\n        </div>\n        <div class="info-row">\n          <span class="label">CAPACITY</span>\n          <span class="value">1回転 約300席 × 2回転</span>\n          <span class="note">最大600人規模の新入生を動員予定</span>\n        </div>\n        <div class="info-row">\n          <span class="label">RUNTIME</span>\n          <span class="value">90分 / 回</span>\n          <span class="note">各団体3分の映像素材を90分の枠に構成</span>\n        </div>\n        <div class="info-row" style="border-bottom:none">\n          <span class="label">PARTICIPANTS</span>\n          <span class="value">目標 約30団体</span>\n          <span class="note">部活動・サークルを横断した合同開催</span>\n        </div>\n        <div class="info-row" style="border-bottom:none">\n          <span class="label">ORGANIZER</span>\n          <span class="value">大学スタイル</span>\n          <span class="note">北大新歓プラットフォームの企画・運営元</span>\n        </div>\n      </div>\n    </div>\n\n    <div class="feature-sub">\n      <div class="feature-sub-head">\n        <h3>当日の目玉施策</h3>\n        <p>ただ上映するだけで終わらせないための、2つの仕掛け</p>\n      </div>\n      <div class="feature-grid">\n        <div class="feature-card">\n          <h4>団体投票機能</h4>\n          <div class="vote-mock">\n            <div class="vm-head">公式LINE投票</div>\n            <div class="vote-cols">\n              <div>\n                <div class="vote-col-title">印象的だった団体</div>\n                <div class="vote-rank"><span class="rn">1</span><span class="rb"></span></div>\n                <div class="vote-rank"><span class="rn">2</span><span class="rb"></span></div>\n                <div class="vote-rank"><span class="rn">3</span><span class="rb"></span></div>\n              </div>\n              <div>\n                <div class="vote-col-title">気になる団体</div>\n                <div class="vote-rank"><span class="rn">1</span><span class="rb"></span></div>\n                <div class="vote-rank"><span class="rn">2</span><span class="rb"></span></div>\n                <div class="vote-rank"><span class="rn">3</span><span class="rb"></span></div>\n              </div>\n            </div>\n          </div>\n          <p class="desc">上映後、公式LINEで「印象的だった団体」「気になる団体」をそれぞれ1〜3位まで複数選択形式で投票。回答データはそのまま団体側に共有されます。</p>\n        </div>\n        <div class="feature-card">\n          <h4>新歓飯チケット</h4>\n          <div class="ticket-side-label">表面</div>\n          <div class="ticket-mock">\n            <span class="tm-icon">\n              <svg viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">\n                <path d="M6.5 2.5v6a1.5 1.5 0 0 0 3 0v-6M8 2.5v8M8 10.5v11"/>\n                <path d="M16.5 2.5c-1.6 0-2.7 2.1-2.7 4.8S14.9 12 16.5 12M16.5 2.5v19"/>\n              </svg>\n            </span>\n            <div class="tm-text">\n              <div class="tm-title">新歓飯チケット</div>\n              <div class="tm-sub">RANDOM DINNER PASS</div>\n            </div>\n            <span class="tm-num">No. 0042</span>\n          </div>\n          <div class="ticket-side-label">裏面</div>\n          <div class="ticket-back">\n            <svg class="qr-mock" viewBox="0 0 29 29" xmlns="http://www.w3.org/2000/svg">\n              <rect width="29" height="29" fill="var(--surface)"/>\n              <g fill="var(--gold)">\n                <rect x="0" y="0" width="7" height="7"/>\n                <rect x="2" y="2" width="3" height="3" fill="var(--surface)"/>\n                <rect x="22" y="0" width="7" height="7"/>\n                <rect x="24" y="2" width="3" height="3" fill="var(--surface)"/>\n                <rect x="0" y="22" width="7" height="7"/>\n                <rect x="2" y="24" width="3" height="3" fill="var(--surface)"/>\n                <rect x="9" y="1" width="2" height="2"/><rect x="13" y="1" width="2" height="2"/><rect x="17" y="3" width="2" height="2"/>\n                <rect x="9" y="9" width="2" height="2"/><rect x="12" y="10" width="3" height="2"/><rect x="17" y="9" width="2" height="3"/><rect x="20" y="11" width="2" height="2"/>\n                <rect x="9" y="13" width="3" height="2"/><rect x="15" y="14" width="2" height="3"/><rect x="19" y="15" width="3" height="2"/>\n                <rect x="10" y="17" width="2" height="2"/><rect x="14" y="18" width="2" height="3"/><rect x="18" y="19" width="2" height="2"/><rect x="22" y="17" width="2" height="2"/>\n                <rect x="9" y="21" width="2" height="2"/><rect x="13" y="22" width="3" height="2"/><rect x="18" y="23" width="2" height="2"/><rect x="22" y="21" width="2" height="2"/>\n                <rect x="9" y="25" width="2" height="2"/><rect x="13" y="26" width="2" height="2"/><rect x="17" y="25" width="2" height="2"/><rect x="21" y="26" width="2" height="2"/><rect x="25" y="25" width="2" height="2"/>\n              </g>\n            </svg>\n            <div class="tb-rows">\n              <div class="tb-row"><span class="tb-label">集合場所</span><span class="tb-value">映画館ロビー（当日案内）</span></div>\n              <div class="tb-row"><span class="tb-label">時間</span><span class="tb-value">21:50〜</span></div>\n              <div class="tb-row"><span class="tb-label">ご飯会場</span><span class="tb-value">近隣飲食店（当日案内）</span></div>\n              <div class="tb-row"><span class="tb-label">グループ</span><span class="tb-value">QR読み取りでLINEグループへ</span></div>\n            </div>\n          </div>\n          <p class="desc">入場する新入生全員に配布。表面はチケット、裏面には集合場所・時間・ご飯会場と、新歓団体グループのQRコードを記載。上映後はこのチケットを使って、ランダムな組み合わせのご飯会（任意参加）に合流できます。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id="flow">\n    <div class="section-head">\n      <span class="num">03 — DAY FLOW</span>\n      <h2>当日の流れ（1回転あたり）</h2>\n    </div>\n    <div class="dayflow">\n      <div class="dayflow-item key">\n        <div class="dayflow-time">18:10</div>\n        <div class="dayflow-marker"><span class="dot"></span></div>\n        <div class="dayflow-body">\n          <h4>入場・新歓飯チケット配布 <span class="key-badge">★</span></h4>\n          <p>入場する新入生全員に新歓飯チケットを配布。上映後のご飯会でランダムな組み合わせの出会いを創出する仕掛け</p>\n        </div>\n      </div>\n      <div class="dayflow-item">\n        <div class="dayflow-time">18:20</div>\n        <div class="dayflow-marker"><span class="dot"></span></div>\n        <div class="dayflow-body">\n          <h4>オープニング</h4>\n          <p>企画趣旨・当日の流れを案内</p>\n        </div>\n      </div>\n      <div class="dayflow-item">\n        <div class="dayflow-time">18:25</div>\n        <div class="dayflow-marker"><span class="dot"></span></div>\n        <div class="dayflow-body">\n          <h4>新歓PV 一斉上映（1回目）</h4>\n          <p>参加団体各3分のPVを、大画面・大音響で連続上映</p>\n        </div>\n      </div>\n      <div class="dayflow-item key">\n        <div class="dayflow-time">–</div>\n        <div class="dayflow-marker"><span class="dot"></span></div>\n        <div class="dayflow-body">\n          <h4>団体投票（公式LINE） <span class="key-badge">★</span></h4>\n          <p>「印象的だった団体」「気になる団体」をそれぞれ1位〜3位まで複数選択形式で投票。回答データはそのまま各団体に共有</p>\n        </div>\n      </div>\n      <div class="dayflow-item">\n        <div class="dayflow-time">–</div>\n        <div class="dayflow-marker"><span class="dot"></span></div>\n        <div class="dayflow-body">\n          <h4>入替・休憩</h4>\n          <p>1回目来場者の退場・2回目来場者の入場（新歓飯チケット配布含む）</p>\n        </div>\n      </div>\n      <div class="dayflow-item">\n        <div class="dayflow-time">–</div>\n        <div class="dayflow-marker"><span class="dot"></span></div>\n        <div class="dayflow-body">\n          <h4>新歓PV 一斉上映（2回目）＋ 団体投票</h4>\n          <p>同内容を2回転目として上映</p>\n        </div>\n      </div>\n      <div class="dayflow-item">\n        <div class="dayflow-time">21:40</div>\n        <div class="dayflow-marker"><span class="dot"></span></div>\n        <div class="dayflow-body">\n          <h4>退場 → 新歓飯チケットでご飯会へ</h4>\n          <p>希望者は配布済みの新歓飯チケットを使い、ランダムな組み合わせのご飯会（任意参加）に合流。各団体との接点をその日のうちに継続</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id="track-record">\n    <div class="section-head">\n      <span class="num">04 — TRACK RECORD</span>\n      <h2>大学スタイルの実績</h2>\n      <p>北大新歓を軸に、団体・新入生をつなぐ運営基盤をこれまで積み重ねてきました。</p>\n    </div>\n    <div class="track-grid">\n      <div class="track-media">\n        <div class="track-visual">\n          <img src="data:image/png;base64," alt="いざ、新歓 2025 北海道大学オンライン新歓 キービジュアル">\n        </div>\n        <div class="track-visual">\n          <img src="data:image/png;base64," alt="新歓プラットフォーム（公式LINEイベント機能）のイメージ">\n        </div>\n      </div>\n      <div class="stats">\n        <div class="stat"><div class="n mono">2021-</div><div class="l">新歓プラットフォーム運営歴</div></div>\n        <div class="stat"><div class="n mono">1,000人+</div><div class="l">平均イベント参加新入生数</div></div>\n        <div class="stat"><div class="n mono">30団体</div><div class="l">今回の参加団体目標</div></div>\n      </div>\n    </div>\n  </section>\n\n  <section id="ask">\n    <div class="section-head">\n      <span class="num">05 — WHAT WE ASK</span>\n      <h2>ラクロス部様にお願いしたいこと</h2>\n    </div>\n    <div class="ask-card">\n      <h3>ご準備いただきたいこと</h3>\n      <ul class="ask-list">\n        <li><span class="chk">✓</span>約3分間のPV素材のご用意（既存のものがあればそのまま／大学スタイル側での新規制作サポートも可）</li>\n        <li><span class="chk">✓</span>企画すり合わせ・素材連携など、進行にあたってのご協力（担当者様との簡単な打ち合わせ）</li>\n        <li><span class="chk">✓</span>当日、可能であれば団体としての立ち会い・声かけ（任意）</li>\n      </ul>\n      <div class="price-note">\n        PV制作をゼロから依頼したい場合も、大学スタイル側で企画〜撮影〜編集まで伴走可能です（映画館クオリティでの制作）。すでに素材をお持ちの場合は制作費は不要です。費用については個別にご相談させてください。\n      </div>\n    </div>\n  </section>\n\n  <section id="process">\n    <div class="section-head">\n      <span class="num">06 — SCHEDULE</span>\n      <h2>参加団体様のスケジュール</h2>\n      <p>★は特に重要な節目です。カッコ書きは新歓PVの制作をご依頼いただく場合のみ発生するステップです。</p>\n    </div>\n    <div class="dayflow">\n      <div class="dayflow-item">\n        <div class="dayflow-time">–</div>\n        <div class="dayflow-marker"><span class="dot"></span></div>\n        <div class="dayflow-body">\n          <h4>担当者様の確定</h4>\n        </div>\n      </div>\n      <div class="dayflow-item key">\n        <div class="dayflow-time">–</div>\n        <div class="dayflow-marker"><span class="dot"></span></div>\n        <div class="dayflow-body">\n          <h4>新歓映画館企画 初回共有打ち合わせ <span class="key-badge">★</span></h4>\n        </div>\n      </div>\n      <div class="dayflow-item conditional">\n        <div class="dayflow-time">–</div>\n        <div class="dayflow-marker"><span class="dot"></span></div>\n        <div class="dayflow-body">\n          <h4>（PV制作依頼の場合）素材のご連携 <span class="cond-badge">制作依頼時のみ</span></h4>\n        </div>\n      </div>\n      <div class="dayflow-item conditional">\n        <div class="dayflow-time">–</div>\n        <div class="dayflow-marker"><span class="dot"></span></div>\n        <div class="dayflow-body">\n          <h4>（PV制作依頼の場合）編集動画のご確認 <span class="cond-badge">制作依頼時のみ</span></h4>\n        </div>\n      </div>\n      <div class="dayflow-item key">\n        <div class="dayflow-time">–</div>\n        <div class="dayflow-marker"><span class="dot"></span></div>\n        <div class="dayflow-body">\n          <h4>放映素材の確定・PV動画のご連携 <span class="key-badge">★</span></h4>\n        </div>\n      </div>\n      <div class="dayflow-item">\n        <div class="dayflow-time">–</div>\n        <div class="dayflow-marker"><span class="dot"></span></div>\n        <div class="dayflow-body">\n          <h4>各団体様ごとのSNS告知／大学スタイル側での広報活動</h4>\n        </div>\n      </div>\n      <div class="dayflow-item">\n        <div class="dayflow-time">–</div>\n        <div class="dayflow-marker"><span class="dot"></span></div>\n        <div class="dayflow-body">\n          <h4>新入生向け事前申し込み締切</h4>\n        </div>\n      </div>\n      <div class="dayflow-item">\n        <div class="dayflow-time">–</div>\n        <div class="dayflow-marker"><span class="dot"></span></div>\n        <div class="dayflow-body">\n          <h4>各団体の放映素材を元にした統合版素材のご確認</h4>\n        </div>\n      </div>\n      <div class="dayflow-item">\n        <div class="dayflow-time">当日</div>\n        <div class="dayflow-marker"><span class="dot"></span></div>\n        <div class="dayflow-body">\n          <h4>上映当日</h4>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id="contact" style="border-bottom:none">\n    <div class="contact-block">\n      <div class="ticket">まずはお話だけでも 河合まで</div>\n      <div class="contact-sub">大学スタイル ／ 河合雅斗</div>\n    </div>\n  </section>\n\n</div>\n\n<footer>新歓映画館 2027 ／ 大学スタイル</footer>';
---

<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{pageTitle}</title>
  {authed && <link rel="stylesheet" href={fontsHref} />}
  {authed && <style set:html={pageCss} />}
  {!authed && (
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0d0b12;
        color: #f4efe4;
        font-family: -apple-system, "Hiragino Sans", sans-serif;
      }
      .login-card {
        background: #16121f;
        border: 1px solid #322a48;
        border-radius: 16px;
        padding: 40px 36px;
        width: min(360px, 88vw);
      }
      .login-card h1 { font-size: 1.05rem; margin: 0 0 20px; }
      .login-card input {
        width: 100%;
        padding: 10px 12px;
        border-radius: 8px;
        border: 1px solid #322a48;
        background: #1e1830;
        color: #f4efe4;
        font-size: 0.9rem;
        margin-bottom: 14px;
        box-sizing: border-box;
      }
      .login-card button {
        width: 100%;
        padding: 10px;
        border-radius: 999px;
        border: none;
        background: #ffb400;
        color: #0d0b12;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
      }
      .login-error { color: #ff6b6b; font-size: 0.8rem; margin: -8px 0 14px; }
    </style>
  )}
</head>
<body>
  {authed ? (
    <Fragment set:html={pageBody} />
  ) : (
    <div class="login-card">
      <h1>パスワードを入力してください</h1>
      {loginError && <p class="login-error">パスワードが違います</p>}
      <form method="POST">
        <input type="password" name="password" placeholder="パスワード" autofocus />
        <button type="submit">開く</button>
      </form>
    </div>
  )}
</body>
</html>
